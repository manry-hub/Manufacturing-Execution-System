datasource db {
  provider = "sqlserver"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// -----------------------------------------------------------------------------
// Identity, Roles & Access Control
// -----------------------------------------------------------------------------

model User {
  id           String               @id @default(uuid())
  username     String               @unique
  email        String               @unique
  passwordHash String               @map("password_hash")
  isActive     Boolean              @default(true) @map("is_active")
  createdAt    DateTime             @default(now()) @map("created_at")
  updatedAt    DateTime             @default(now()) @updatedAt @map("updated_at")

  userRoles       UserRoleAssignment[]
  auditLogs       AuditLog[]
  reportedTickets AndonTicket[]        @relation("ReportedTickets")
  assignedTickets AndonTicket[]        @relation("AssignedTickets")

  loadedConsumptions        RunMaterialConsumption[]
  conductedQualityChecks    QualityCheck[]
  assignedMaintenanceOrders MaintenanceWorkOrder[]
  packedUnits               PackagingUnit[]

  @@map("users")
}

model Role {
  id          String               @id @default(uuid())
  name        String               @unique
  description String?

  userRoles UserRoleAssignment[]

  @@map("roles")
}

model UserRoleAssignment {
  userId String @map("user_id")
  roleId String @map("role_id")

  user User @relation(fields: [userId], references: [id], onUpdate: NoAction, onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onUpdate: NoAction, onDelete: Cascade)

  @@id([userId, roleId])
  @@map("user_role_assignments")
}

model AuditLog {
  id         BigInt   @id @default(autoincrement())
  userId     String?  @map("user_id")
  action     String   @db.VarChar(100)
  entityType String   @map("entity_type") @db.VarChar(50)
  entityId   String   @map("entity_id") @db.VarChar(36)
  oldValues  String?  @map("old_values") @db.NVarChar(Max)
  newValues  String?  @map("new_values") @db.NVarChar(Max)
  createdAt  DateTime @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id], onUpdate: NoAction, onDelete: SetNull)

  @@index([entityType, entityId, createdAt(sort: Desc)], name: "idx_audit_query")
  @@map("audit_logs")
}

// -----------------------------------------------------------------------------
// Factory Structure & Master Data
// -----------------------------------------------------------------------------

model Plant {
  id        String   @id @default(uuid())
  code      String   @unique @db.VarChar(50)
  name      String   @db.VarChar(150)
  timezone  String   @default("UTC") @db.VarChar(50)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  productionAreas ProductionArea[]

  @@map("plants")
}

model ProductionArea {
  id        String   @id @default(uuid())
  plantId   String   @map("plant_id")
  code      String   @db.VarChar(50)
  name      String   @db.VarChar(150)
  createdAt DateTime @default(now()) @map("created_at")

  plant    Plant     @relation(fields: [plantId], references: [id], onUpdate: NoAction, onDelete: Cascade)
  machines Machine[]

  @@unique([plantId, code], name: "uq_area_plant_code")
  @@index([plantId], name: "idx_area_plant")
  @@map("production_areas")
}

model Machine {
  id              String   @id @default(uuid())
  areaId          String   @map("area_id")
  code            String   @unique @db.VarChar(50)
  name            String   @db.VarChar(150)
  clampingTonnage Int?     @map("clamping_tonnage")
  isVirtual       Boolean  @default(true) @map("is_virtual")
  createdAt       DateTime @default(now()) @map("created_at")

  area                  ProductionArea         @relation(fields: [areaId], references: [id], onUpdate: NoAction, onDelete: Cascade)
  currentState          MachineCurrentState?
  eventLogs             MachineEventLog[]
  timeSegments          MachineTimeSegment[]
  oeeResults            OeeResult[]
  andonTickets          AndonTicket[]
  productionRuns        ProductionRun[]
  maintenanceWorkOrders MaintenanceWorkOrder[]
  scheduledOrders       ProductionOrder[]      @relation("MachineScheduledOrders")

  @@index([areaId], name: "idx_machine_area")
  @@map("machines")
}

// -----------------------------------------------------------------------------
// Products, Tooling & Process Recipes
// -----------------------------------------------------------------------------

model Product {
  id                String   @id @default(uuid())
  partNumber        String   @unique @map("part_number") @db.VarChar(100)
  name              String   @db.VarChar(200)
  standardCycleTime Decimal  @map("standard_cycle_time") @db.Decimal(8, 2)
  createdAt         DateTime @default(now()) @map("created_at")

  compatibilities  MoldProductCompatibility[]
  productionOrders ProductionOrder[]
  inspectionPlans  InspectionPlan[]

  @@map("products")
}

model Mold {
  id          String   @id @default(uuid())
  code        String   @unique @db.VarChar(50)
  name        String   @db.VarChar(150)
  cavityCount Int      @default(1) @map("cavity_count")
  totalShots  BigInt   @default(0) @map("total_shots")
  status      String   @default("AVAILABLE") @db.VarChar(30)

  compatibilities       MoldProductCompatibility[]
  productionRuns        ProductionRun[]
  pmSchedules           MoldPmSchedule[]
  maintenanceWorkOrders MaintenanceWorkOrder[]
  fromChangeovers       MoldChangeover[]           @relation("FromMoldChangeovers")
  toChangeovers         MoldChangeover[]           @relation("ToMoldChangeovers")
  scheduledOrders       ProductionOrder[]          @relation("MoldScheduledOrders")

  @@map("molds")
}

model MoldProductCompatibility {
  id             String  @id @default(uuid())
  moldId         String  @map("mold_id")
  productId      String  @map("product_id")
  idealCycleTime Decimal @map("ideal_cycle_time") @db.Decimal(8, 2)

  mold    Mold    @relation(fields: [moldId], references: [id], onUpdate: NoAction, onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onUpdate: NoAction, onDelete: Cascade)

  @@unique([moldId, productId], name: "uq_mold_product")
  @@index([moldId], name: "idx_comp_mold")
  @@index([productId], name: "idx_comp_product")
  @@map("mold_product_compatibilities")
}

// -----------------------------------------------------------------------------
// Production Planning & Execution
// -----------------------------------------------------------------------------

model ProductionOrder {
  id               String    @id @default(uuid())
  orderNumber      String    @unique @map("order_number") @db.VarChar(50)
  productId        String    @map("product_id")
  targetQuantity   Int       @map("target_quantity")
  packedQuantity   Int       @default(0) @map("packed_quantity")
  status           String    @default("DRAFT") @db.VarChar(30)
  plannedStartTime DateTime  @map("planned_start_time")
  actualStartTime  DateTime? @map("actual_start_time")
  actualEndTime    DateTime? @map("actual_end_time")
  createdAt        DateTime  @default(now()) @map("created_at")

  // Scheduling extensions
  plannedEndTime    DateTime? @map("planned_end_time")
  assignedMachineId String?   @map("assigned_machine_id")
  assignedMoldId    String?   @map("assigned_mold_id")
  priority          Int       @default(3) @map("priority") // 1: Urgent, 2: High, 3: Normal, 4: Low
  sequenceOrder     Int       @default(0) @map("sequence_order")
  schedulingNotes   String?   @map("scheduling_notes") @db.VarChar(255)

  product         Product              @relation(fields: [productId], references: [id], onUpdate: NoAction, onDelete: NoAction)
  assignedMachine Machine?             @relation("MachineScheduledOrders", fields: [assignedMachineId], references: [id], onUpdate: NoAction, onDelete: SetNull)
  assignedMold    Mold?                @relation("MoldScheduledOrders", fields: [assignedMoldId], references: [id], onUpdate: NoAction, onDelete: SetNull)
  runs            ProductionRun[]
  operationSteps  OrderOperationStep[]

  @@index([productId], name: "idx_po_product")
  @@index([status], name: "idx_po_status")
  @@index([assignedMachineId, plannedStartTime], name: "idx_po_machine_schedule")
  @@index([assignedMoldId], name: "idx_po_assigned_mold")
  @@map("production_orders")
}

model ProductionRun {
  id                String    @id @default(uuid())
  productionOrderId String    @map("production_order_id")
  machineId         String    @map("machine_id")
  moldId            String    @map("mold_id")
  status            String    @default("SETUP") @db.VarChar(30)
  totalShots        Int       @default(0) @map("total_shots")
  goodQuantity      Int       @default(0) @map("good_quantity")
  rejectQuantity    Int       @default(0) @map("reject_quantity")
  startTime         DateTime  @default(now()) @map("start_time")
  endTime           DateTime? @map("end_time")

  productionOrder ProductionOrder          @relation(fields: [productionOrderId], references: [id], onUpdate: NoAction, onDelete: NoAction)
  machine         Machine                  @relation(fields: [machineId], references: [id], onUpdate: NoAction, onDelete: NoAction)
  mold            Mold                     @relation(fields: [moldId], references: [id], onUpdate: NoAction, onDelete: NoAction)
  currentStates   MachineCurrentState[]
  oeeResults      OeeResult[]
  consumptions    RunMaterialConsumption[]
  qualityChecks   QualityCheck[]
  packagingUnits  PackagingUnit[]

  @@index([productionOrderId], name: "idx_pr_order")
  @@index([machineId], name: "idx_pr_machine")
  @@index([status], name: "idx_pr_status")
  @@map("production_runs")
}

// -----------------------------------------------------------------------------
// Machine Integration & Telemetry Projections
// -----------------------------------------------------------------------------

model MachineCurrentState {
  machineId          String   @id @map("machine_id")
  normalizedStatus   String   @map("normalized_status") @db.VarChar(30)
  rawStatus          String?  @map("raw_status") @db.VarChar(100)
  activeRunId        String?  @map("active_run_id")
  currentCycleTime   Decimal? @map("current_cycle_time") @db.Decimal(8, 2)
  lastEventTimestamp DateTime @map("last_event_timestamp")
  connectionStatus   String   @default("ONLINE") @map("connection_status") @db.VarChar(30)
  updatedAt          DateTime @default(now()) @updatedAt @map("updated_at")

  machine   Machine        @relation(fields: [machineId], references: [id], onUpdate: NoAction, onDelete: Cascade)
  activeRun ProductionRun? @relation(fields: [activeRunId], references: [id], onUpdate: NoAction, onDelete: NoAction)

  @@map("machine_current_states")
}

model MachineEventLog {
  id                 BigInt   @id @default(autoincrement())
  eventId            String   @unique @map("event_id") @db.VarChar(64)
  machineId          String   @map("machine_id")
  eventType          String   @map("event_type") @db.VarChar(50)
  normalizedStatus   String   @map("normalized_status") @db.VarChar(30)
  sourceTimestamp    DateTime @map("source_timestamp")
  receivedTimestamp  DateTime @default(now()) @map("received_timestamp")
  cycleCounter       BigInt?  @map("cycle_counter")
  faultCode          String?  @map("fault_code") @db.VarChar(50)
  rawPayload         String?  @map("raw_payload") @db.NVarChar(Max)
  isSimulated        Boolean  @default(true) @map("is_simulated")

  machine Machine @relation(fields: [machineId], references: [id], onUpdate: NoAction, onDelete: Cascade)

  @@index([machineId, sourceTimestamp(sort: Desc)], name: "idx_mel_machine_time")
  @@index([eventType], name: "idx_mel_type")
  @@map("machine_event_logs")
}

// -----------------------------------------------------------------------------
// OEE & Downtime Segments
// -----------------------------------------------------------------------------

model DowntimeReason {
  id          String  @id @default(uuid())
  code        String  @unique @db.VarChar(50)
  category    String  @db.VarChar(50)
  description String  @db.VarChar(200)
  isPlanned   Boolean @default(false) @map("is_planned")

  timeSegments MachineTimeSegment[]

  @@map("downtime_reasons")
}

model MachineTimeSegment {
  id               BigInt   @id @default(autoincrement())
  machineId        String   @map("machine_id")
  category         String   @db.VarChar(30)
  startTime        DateTime @map("start_time")
  endTime          DateTime @map("end_time")
  durationSeconds  Int      @map("duration_seconds")
  downtimeReasonId String?  @map("downtime_reason_id")

  machine        Machine         @relation(fields: [machineId], references: [id], onUpdate: NoAction, onDelete: Cascade)
  downtimeReason DowntimeReason? @relation(fields: [downtimeReasonId], references: [id], onUpdate: NoAction, onDelete: SetNull)

  @@index([machineId, startTime, endTime], name: "idx_mts_machine_window")
  @@map("machine_time_segments")
}

model OeeResult {
  id                String   @id @default(uuid())
  machineId         String   @map("machine_id")
  runId             String?  @map("run_id")
  calculationWindow String   @map("calculation_window") @db.VarChar(20)
  availability      Decimal  @db.Decimal(5, 4)
  performance       Decimal  @db.Decimal(5, 4)
  quality           Decimal  @db.Decimal(5, 4)
  oee               Decimal  @db.Decimal(5, 4)
  timestamp         DateTime @default(now())

  machine Machine        @relation(fields: [machineId], references: [id], onUpdate: NoAction, onDelete: Cascade)
  run     ProductionRun? @relation(fields: [runId], references: [id], onUpdate: NoAction, onDelete: NoAction)

  @@index([machineId, timestamp(sort: Desc)], name: "idx_oee_lookup")
  @@map("oee_results")
}

// -----------------------------------------------------------------------------
// Digital Andon Tickets
// -----------------------------------------------------------------------------

model AndonTicket {
  id                 String    @id @default(uuid())
  ticketNumber       String    @unique @map("ticket_number") @db.VarChar(50)
  machineId          String    @map("machine_id")
  category           String    @db.VarChar(50)
  status             String    @default("OPEN") @db.VarChar(30)
  reportedById       String    @map("reported_by_id")
  assignedToId       String?   @map("assigned_to_id")
  reportTime         DateTime  @default(now()) @map("report_time")
  responseTime       DateTime? @map("response_time")
  resolutionTime     DateTime? @map("resolution_time")
  confirmedRootCause String?   @map("confirmed_root_cause") @db.NVarChar(500)
  correctiveAction   String?   @map("corrective_action") @db.NVarChar(500)

  machine    Machine @relation(fields: [machineId], references: [id], onUpdate: NoAction, onDelete: Cascade)
  reportedBy User    @relation("ReportedTickets", fields: [reportedById], references: [id], onUpdate: NoAction, onDelete: NoAction)
  assignedTo User?   @relation("AssignedTickets", fields: [assignedToId], references: [id], onUpdate: NoAction, onDelete: NoAction)

  @@index([machineId, status], name: "idx_andon_active")
  @@map("andon_tickets")
}

// -----------------------------------------------------------------------------
// Materials & Bidirectional Genealogy
// -----------------------------------------------------------------------------

model Material {
  id          String   @id @default(uuid())
  code        String   @unique @db.VarChar(50)
  name        String   @db.VarChar(150)
  category    String   @db.VarChar(50) // BASE_RESIN, MASTERBATCH, ADDITIVE, REGRIND
  densityGcm3 Decimal? @map("density_gcm3") @db.Decimal(6, 4)
  createdAt   DateTime @default(now()) @map("created_at")

  lots MaterialLot[]

  @@map("materials")
}

model MaterialLot {
  id             String    @id @default(uuid())
  materialId     String    @map("material_id")
  lotNumber      String    @unique @map("lot_number") @db.VarChar(100)
  supplierLot    String?   @map("supplier_lot") @db.VarChar(100)
  initialQtyKg   Decimal   @map("initial_qty_kg") @db.Decimal(10, 2)
  remainingQtyKg Decimal   @map("remaining_qty_kg") @db.Decimal(10, 2)
  status         String    @default("AVAILABLE") @db.VarChar(30) // AVAILABLE, CONSUMED, EXPIRED, QUARANTINE
  expirationDate DateTime? @map("expiration_date")
  receivedAt     DateTime  @default(now()) @map("received_at")

  material     Material                 @relation(fields: [materialId], references: [id], onUpdate: NoAction, onDelete: Cascade)
  consumptions RunMaterialConsumption[]

  @@index([materialId], name: "idx_lot_material")
  @@index([status], name: "idx_lot_status")
  @@map("material_lots")
}

model RunMaterialConsumption {
  id            String   @id @default(uuid())
  runId         String   @map("run_id")
  materialLotId String   @map("material_lot_id")
  loadedById    String   @map("loaded_by_id")
  quantityKg    Decimal  @map("quantity_kg") @db.Decimal(10, 2)
  loadedAt      DateTime @default(now()) @map("loaded_at")

  run         ProductionRun @relation(fields: [runId], references: [id], onUpdate: NoAction, onDelete: Cascade)
  materialLot MaterialLot   @relation(fields: [materialLotId], references: [id], onUpdate: NoAction, onDelete: NoAction)
  loadedBy    User          @relation(fields: [loadedById], references: [id], onUpdate: NoAction, onDelete: NoAction)

  @@index([runId], name: "idx_rmc_run")
  @@index([materialLotId], name: "idx_rmc_lot")
  @@map("run_material_consumptions")
}

// -----------------------------------------------------------------------------
// Quality Gates & Inspection Plans
// -----------------------------------------------------------------------------

model InspectionPlan {
  id        String   @id @default(uuid())
  productId String   @map("product_id")
  name      String   @db.VarChar(150)
  version   Int      @default(1)
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")

  product Product              @relation(fields: [productId], references: [id], onUpdate: NoAction, onDelete: Cascade)
  items   InspectionPlanItem[]

  @@index([productId], name: "idx_ip_product")
  @@map("inspection_plans")
}

model InspectionPlanItem {
  id              String   @id @default(uuid())
  planId          String   @map("plan_id")
  sequence        Int
  parameterName   String   @map("parameter_name") @db.VarChar(100)
  measurementType String   @map("measurement_type") @db.VarChar(30) // VARIABLE, ATTRIBUTE
  targetValue     Decimal? @map("target_value") @db.Decimal(10, 3)
  upperTolerance  Decimal? @map("upper_tolerance") @db.Decimal(10, 3)
  lowerTolerance  Decimal? @map("lower_tolerance") @db.Decimal(10, 3)
  inspectionStage String   @default("PATROL") @map("inspection_stage") @db.VarChar(30) // FIRST_PIECE, PATROL, FINAL_AUDIT

  plan    InspectionPlan       @relation(fields: [planId], references: [id], onUpdate: NoAction, onDelete: Cascade)
  samples QualityCheckSample[]

  @@index([planId], name: "idx_ipi_plan")
  @@map("inspection_plan_items")
}

model QualityCheck {
  id          String   @id @default(uuid())
  runId       String   @map("run_id")
  inspectorId String   @map("inspector_id")
  checkType   String   @map("check_type") @db.VarChar(30) // FIRST_PIECE, HOURLY_PATROL, CONTAINMENT
  disposition String   @default("PENDING") @db.VarChar(30) // PENDING, RELEASED, QUARANTINE, REWORK, SCRAP
  notes       String?  @db.NVarChar(500)
  checkedAt   DateTime @default(now()) @map("checked_at")

  run       ProductionRun        @relation(fields: [runId], references: [id], onUpdate: NoAction, onDelete: Cascade)
  inspector User                 @relation(fields: [inspectorId], references: [id], onUpdate: NoAction, onDelete: NoAction)
  samples   QualityCheckSample[]

  @@index([runId], name: "idx_qc_run")
  @@index([disposition], name: "idx_qc_disposition")
  @@map("quality_checks")
}

model QualityCheckSample {
  id             BigInt   @id @default(autoincrement())
  qualityCheckId String   @map("quality_check_id")
  planItemId     String   @map("plan_item_id")
  measuredValue  Decimal? @map("measured_value") @db.Decimal(10, 3)
  isPassed       Boolean  @map("is_passed")

  qualityCheck QualityCheck       @relation(fields: [qualityCheckId], references: [id], onUpdate: NoAction, onDelete: Cascade)
  planItem     InspectionPlanItem @relation(fields: [planItemId], references: [id], onUpdate: NoAction, onDelete: NoAction)

  @@index([qualityCheckId], name: "idx_qcs_check")
  @@map("quality_check_samples")
}

// -----------------------------------------------------------------------------
// Tooling & Mold Preventive Maintenance
// -----------------------------------------------------------------------------

model MoldPmSchedule {
  id               String  @id @default(uuid())
  moldId           String  @map("mold_id")
  pmLevel          String  @map("pm_level") @db.VarChar(50) // LEVEL_1_CLEAN, LEVEL_2_INSPECT, LEVEL_3_OVERHAUL
  intervalShots    BigInt  @map("interval_shots")
  lastServicedShot BigInt  @default(0) @map("last_serviced_shot")
  isActive         Boolean @default(true) @map("is_active")

  mold Mold @relation(fields: [moldId], references: [id], onUpdate: NoAction, onDelete: Cascade)

  @@index([moldId], name: "idx_pm_mold")
  @@map("mold_pm_schedules")
}

model MaintenanceWorkOrder {
  id               String    @id @default(uuid())
  orderNumber      String    @unique @map("order_number") @db.VarChar(50)
  moldId           String?   @map("mold_id")
  machineId        String?   @map("machine_id")
  workType         String    @map("work_type") @db.VarChar(30) // PREVENTIVE_SHOT, CORRECTIVE_BREAKDOWN, CHANGEOVER
  status           String    @default("OPEN") @db.VarChar(30) // OPEN, IN_PROGRESS, COMPLETED, CANCELLED
  assignedTechId   String?   @map("assigned_tech_id")
  triggerShots     BigInt?   @map("trigger_shots")
  checklistPayload String?   @map("checklist_payload") @db.NVarChar(Max)
  createdAt        DateTime  @default(now()) @map("created_at")
  completedAt      DateTime? @map("completed_at")

  mold         Mold?    @relation(fields: [moldId], references: [id], onUpdate: NoAction, onDelete: SetNull)
  machine      Machine? @relation(fields: [machineId], references: [id], onUpdate: NoAction, onDelete: SetNull)
  assignedTech User?    @relation(fields: [assignedTechId], references: [id], onUpdate: NoAction, onDelete: NoAction)

  @@index([moldId], name: "idx_mwo_mold")
  @@index([machineId], name: "idx_mwo_machine")
  @@index([status], name: "idx_mwo_status")
  @@map("maintenance_work_orders")
}

// -----------------------------------------------------------------------------
// Finished Goods Packaging & Traceability
// -----------------------------------------------------------------------------

model PackagingUnit {
  id         String   @id @default(uuid())
  runId      String   @map("run_id")
  barcode    String   @unique @db.VarChar(100)
  partCount  Int      @map("part_count")
  packagerId String   @map("packager_id")
  palletId   String?  @map("pallet_id") @db.VarChar(50)
  packedAt   DateTime @default(now()) @map("packed_at")

  run      ProductionRun @relation(fields: [runId], references: [id], onUpdate: NoAction, onDelete: Cascade)
  packager User          @relation(fields: [packagerId], references: [id], onUpdate: NoAction, onDelete: NoAction)

  @@index([runId], name: "idx_pkg_run")
  @@index([palletId], name: "idx_pkg_pallet")
  @@map("packaging_units")
}

// -----------------------------------------------------------------------------
// Multi-Stage Hybrid Operation Routings
// -----------------------------------------------------------------------------

model OrderOperationStep {
  id                String    @id @default(uuid())
  productionOrderId String    @map("production_order_id")
  sequence          Int
  operationName     String    @map("operation_name") @db.VarChar(50) // MOLDING, SECONDARY_FINISHING, PACKAGING
  stationType       String    @map("station_type") @db.VarChar(50) // INJECTION_MACHINE, MANUAL_WORKBENCH, PACKAGING_STATION
  status            String    @default("PENDING") @db.VarChar(30) // PENDING, IN_PROGRESS, COMPLETED, SKIPPED
  quantityIn        Int       @default(0) @map("quantity_in")
  quantityPassed    Int       @default(0) @map("quantity_passed")
  quantityScrapped  Int       @default(0) @map("quantity_scrapped")
  startedAt         DateTime? @map("started_at")
  completedAt       DateTime? @map("completed_at")

  productionOrder ProductionOrder @relation(fields: [productionOrderId], references: [id], onUpdate: NoAction, onDelete: Cascade)

  @@index([productionOrderId], name: "idx_oos_order")
  @@map("order_operation_steps")
}

model MoldChangeover {
  id           String @id @default(uuid())
  fromMoldId   String @map("from_mold_id")
  toMoldId     String @map("to_mold_id")
  setupMinutes Int    @map("setup_minutes")
  purgeMinutes Int    @default(15) @map("purge_minutes")

  fromMold Mold @relation("FromMoldChangeovers", fields: [fromMoldId], references: [id], onUpdate: NoAction, onDelete: NoAction)
  toMold   Mold @relation("ToMoldChangeovers", fields: [toMoldId], references: [id], onUpdate: NoAction, onDelete: NoAction)

  @@unique([fromMoldId, toMoldId], name: "uq_mold_changeover")
  @@map("mold_changeovers")
}
