{
  "name": "mes",
  "private": true,
  "packageManager": "pnpm@12.6.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "concurrently -n api,web -c blue,green \"pnpm dev:be\" \"pnpm dev:fe\"",
    "dev:be": "pnpm --filter backend start:dev",
    "dev:fe": "pnpm --filter frontend dev",
    "build": "pnpm -r build",
    "build:be": "pnpm --filter backend build",
    "build:fe": "pnpm --filter frontend build",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "mock:edge": "pnpm --filter backend mock:edge",
    "format": "prettier --write \"{backend,frontend}/**/*.{ts,tsx,js,json,css,md}\"",
    "clean": "pnpm -r exec rm -rf dist node_modules && rm -rf node_modules"
  },
  "devDependencies": {
    "concurrently": "^9.0.0",
    "prettier": "^3.3.0"
  }
}
