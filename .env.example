# Environment Mode
NODE_ENV=development

# -----------------------------------------------------------------------------
# Microsoft SQL Server 2022 (Docker Compose & Local Service)
# Note: SA Password MUST satisfy SQL Server complexity requirements:
# At least 8 characters long, containing uppercase, lowercase, digits, and symbols.
# -----------------------------------------------------------------------------
MSSQL_SA_PASSWORD=YourStrong!Password2026
MSSQL_PORT=1433
MSSQL_DB=MES_DB

# Prisma Connection URL for Microsoft SQL Server
DATABASE_URL="sqlserver://localhost:1433;database=MES_DB;user=sa;password=YourStrong!Password2026;trustServerCertificate=true;encrypt=true"

# -----------------------------------------------------------------------------
# Backend Authentication & API Server
# -----------------------------------------------------------------------------
PORT=3000
JWT_SECRET=mes_dev_super_secret_jwt_key_at_least_32_characters_long
JWT_EXPIRATION=8h

# -----------------------------------------------------------------------------
# Frontend Dev Server
# -----------------------------------------------------------------------------
VITE_PORT=5173
